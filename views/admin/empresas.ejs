<%- include('../partials/cabecalho', { titulo: 'Empresas' }) %>

<section class="section">
    <div class="container">

        <div class="page-header">
            <h1>Empresas cadastradas</h1>
            <p class="muted">
                Consulte o cadastro e a situação do convênio.
            </p>
        </div>

        <div class="table-wrap">
            <table>

                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>CNPJ</th>
                        <th>Contato</th>
                        <th>Convênio</th>
                        <th>Cadastro</th>
                        <th>Ação</th>
                    </tr>
                </thead>

                <tbody>
                    <% empresas.forEach(e => { const c = ultimoConvenio[String(e._id)]; %>
                        <tr>

                            <td>
                                <% if (e.logo?.caminho) { %><img class="mini-logo" src="/midia/empresas/<%= e._id %>/logo" alt=""><% } else { %><span class="mini-initials"><%= iniciais(e.nomeFantasia) %></span><% } %>
                                <strong><%= formatarNomeProprio(e.nomeFantasia) %></strong>
                                <br>
                                <small><%= e.razaoSocial %></small>
                            </td>

                            <td>
                                <%= e.cnpj %>
                            </td>

                            <td>
                                <%= e.emailContato %>
                                <br>
                                <%= e.telefone %>
                            </td>

                            <td>
                                <span class="badge <%= (c?.status || 'pendente').toLowerCase() %>">
                                    <%= c?.status || 'SEM CONVÊNIO' %>
                                </span>
                            </td>

                            <td>
                                <span class="badge <%= e.statusCadastro.toLowerCase() %>">
                                    <%= e.statusCadastro %>
                                </span>
                            </td>

                            <td>
                                <form
                                    method="post"
                                    action="/admin/empresas/<%= e._id %>/status"
                                    class="stack"
                                >
                                    <select name="status">
                                        <% ['PENDENTE','APROVADO','REPROVADO'].forEach(s => { %>
                                            <option <%= e.statusCadastro == s ? 'selected' : '' %>>
                                                <%= s %>
                                            </option>
                                        <% }) %>
                                    </select>

                                    <button class="btn btn-small">
                                        Salvar
                                    </button>
                                </form>
                            </td>

                        </tr>
                    <% }) %>
                </tbody>

            </table>
        </div>

        <% if (!empresas.length) { %>
            <div class="empty">
                Nenhuma empresa cadastrada.
            </div>
        <% } %>

    </div>
</section>

<%- include('../partials/rodape') %>
