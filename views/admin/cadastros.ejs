<%- include('../partials/cabecalho', { titulo: 'Cadastros institucionais' }) %>

<section class="section"><div class="container">
  <div class="page-header"><h1>Cadastros institucionais</h1><p class="muted">Gerencie campi, áreas e regras de estágio por curso.</p></div>

  <section class="admin-register-section" aria-labelledby="campi-titulo">
    <div class="section-heading"><div><h2 id="campi-titulo">Campi</h2><p class="muted">Unidades usadas nos perfis e nas vagas.</p></div></div>
    <form class="card form-grid compact-form" method="post" action="/admin/campi"><div class="field"><label>Nome *</label><input name="nome" required></div><div class="field"><label>Cidade *</label><input name="cidade" required></div><div class="field action-field"><button class="btn">Cadastrar campus</button></div></form>
    <div class="record-list"><% campi.forEach(c => { %><article class="record-row"><div><strong><%= c.nome %></strong><small><%= c.cidade %></small></div><span class="badge <%= c.ativo ? 'ativo' : 'inativo' %>"><%= c.ativo ? 'ATIVO' : 'INATIVO' %></span><div class="actions table-actions"><form method="post" action="/admin/cadastros/campus/<%= c._id %>/alternar"><button class="btn btn-small btn-secondary"><%= c.ativo ? 'Desativar' : 'Ativar' %></button></form><form method="post" action="/admin/cadastros/campus/<%= c._id %>/excluir" data-confirmar="Excluir este campus permanentemente?"><button class="btn btn-small btn-danger">Excluir</button></form></div></article><% }) %><% if (!campi.length) { %><div class="empty">Nenhum campus cadastrado.</div><% } %></div>
  </section>

  <section class="admin-register-section" aria-labelledby="areas-titulo">
    <div class="section-heading"><div><h2 id="areas-titulo">Áreas de atuação</h2><p class="muted">Apenas áreas ativas aparecem nos novos cursos e vagas.</p></div></div>
    <form class="card form-grid compact-form" method="post" action="/admin/areas"><div class="field"><label>Nome *</label><input name="nome" required></div><div class="field action-field"><button class="btn">Cadastrar área</button></div></form>
    <div class="record-list"><% areas.forEach(a => { %><article class="record-row"><div><strong><%= a.nome %></strong><small>Área de atuação</small></div><span class="badge <%= a.ativo ? 'ativo' : 'inativo' %>"><%= a.ativo ? 'ATIVA' : 'INATIVA' %></span><div class="actions table-actions"><form method="post" action="/admin/cadastros/area/<%= a._id %>/alternar"><button class="btn btn-small btn-secondary"><%= a.ativo ? 'Desativar' : 'Ativar' %></button></form><form method="post" action="/admin/cadastros/area/<%= a._id %>/excluir" data-confirmar="Excluir esta área permanentemente?"><button class="btn btn-small btn-danger">Excluir</button></form></div></article><% }) %><% if (!areas.length) { %><div class="empty">Nenhuma área cadastrada.</div><% } %></div>
  </section>

  <section class="admin-register-section" aria-labelledby="cursos-titulo">
    <div class="section-heading"><div><h2 id="cursos-titulo">Cursos</h2><p class="muted">As regras abaixo controlam a validação da jornada e do estágio obrigatório.</p></div></div>
    <form class="card form-grid" method="post" action="/admin/cursos" data-required-checks="areasRelacionadas">
      <div class="field"><label>Nome *</label><input name="nome" required></div>
      <div class="field"><label>Nível *</label><select name="nivel" required><option>TÉCNICO</option><option>SUPERIOR</option><option>PÓS-GRADUAÇÃO</option></select></div>
      <div class="field"><label>Campus *</label><select name="campus" required><% campi.filter(c => c.ativo).forEach(c => { %><option value="<%= c._id %>"><%= c.nome %></option><% }) %></select></div>
      <div class="field"><label>Período mínimo obrigatório *</label><input name="periodoMinimoObrigatorio" type="number" min="1" max="20" value="1" required></div>
      <div class="field"><label>Máximo diário *</label><input name="cargaHorariaDiariaMaxima" type="number" min="1" max="8" value="6" required></div>
      <div class="field"><label>Máximo semanal *</label><input name="cargaHorariaSemanalMaxima" type="number" min="1" max="40" value="30" required></div>
      <div class="field full"><label>Áreas relacionadas *</label><div class="check-grid"><% areasAtivas.forEach(a => { %><label class="check-card"><input type="checkbox" name="areasRelacionadas" value="<%= a._id %>" data-group-required="areas-novo"><span><%= a.nome %></span></label><% }) %></div></div>
      <div class="field full check-grid compact"><label class="check-card"><input type="checkbox" name="exigeConvenio" checked><span>Exige convênio</span></label><label class="check-card"><input type="checkbox" name="permiteEstagioObrigatorio" checked><span>Permite obrigatório</span></label><label class="check-card"><input type="checkbox" name="permiteEstagioNaoObrigatorio" checked><span>Permite não obrigatório</span></label><label class="check-card"><input type="checkbox" name="permiteJornada40h"><span>40h somente se PPC/alternância permitir</span></label></div>
      <div class="field full"><button class="btn">Cadastrar curso</button></div>
    </form>

    <div class="course-list"><% cursos.forEach(c => { %><details class="card course-card"><summary><span><strong><%= c.nome %></strong><small><%= c.nivel %> · <%= c.campus?.nome || 'Campus não encontrado' %></small></span><span class="badge <%= c.ativo ? 'ativo' : 'inativo' %>"><%= c.ativo ? 'ATIVO' : 'INATIVO' %></span></summary><form method="post" action="/admin/cursos/<%= c._id %>" class="form-grid course-edit">
      <div class="field"><label>Nome *</label><input name="nome" value="<%= c.nome %>" required></div><div class="field"><label>Nível *</label><select name="nivel" required><% ['TÉCNICO','SUPERIOR','PÓS-GRADUAÇÃO'].forEach(n => { %><option <%= c.nivel === n ? 'selected' : '' %>><%= n %></option><% }) %></select></div><div class="field"><label>Campus *</label><select name="campus" required><% campi.filter(x => x.ativo || String(x._id) === String(c.campus?._id)).forEach(x => { %><option value="<%= x._id %>" <%= String(x._id) === String(c.campus?._id) ? 'selected' : '' %>><%= x.nome %></option><% }) %></select></div><div class="field"><label>Período mínimo *</label><input name="periodoMinimoObrigatorio" type="number" min="1" max="20" value="<%= c.regrasEstagio?.periodoMinimoObrigatorio || 1 %>" required></div><div class="field"><label>Máximo diário *</label><input name="cargaHorariaDiariaMaxima" type="number" min="1" max="8" value="<%= c.regrasEstagio?.cargaHorariaDiariaMaxima || 6 %>" required></div><div class="field"><label>Máximo semanal *</label><input name="cargaHorariaSemanalMaxima" type="number" min="1" max="40" value="<%= c.regrasEstagio?.cargaHorariaSemanalMaxima || 30 %>" required></div>
      <div class="field full"><label>Áreas relacionadas *</label><div class="check-grid"><% areasAtivas.forEach(a => { const marcada = c.areasRelacionadas?.some(x => String(x._id) === String(a._id)); %><label class="check-card"><input type="checkbox" name="areasRelacionadas" value="<%= a._id %>" <%= marcada ? 'checked' : '' %> data-group-required="areas-<%= c._id %>"><span><%= a.nome %></span></label><% }) %></div></div>
      <div class="field full check-grid compact"><label class="check-card"><input type="checkbox" name="exigeConvenio" <%= c.regrasEstagio?.exigeConvenio !== false ? 'checked' : '' %>><span>Exige convênio</span></label><label class="check-card"><input type="checkbox" name="permiteEstagioObrigatorio" <%= c.regrasEstagio?.permiteEstagioObrigatorio !== false ? 'checked' : '' %>><span>Permite obrigatório</span></label><label class="check-card"><input type="checkbox" name="permiteEstagioNaoObrigatorio" <%= c.regrasEstagio?.permiteEstagioNaoObrigatorio !== false ? 'checked' : '' %>><span>Permite não obrigatório</span></label><label class="check-card"><input type="checkbox" name="permiteJornada40h" <%= c.regrasEstagio?.permiteJornada40h ? 'checked' : '' %>><span>Permite 40h conforme PPC</span></label></div><div class="field full actions"><button class="btn">Salvar curso</button></div></form><div class="actions card-footer-actions"><form method="post" action="/admin/cadastros/curso/<%= c._id %>/alternar"><button class="btn btn-small btn-secondary"><%= c.ativo ? 'Desativar' : 'Ativar' %></button></form><form method="post" action="/admin/cadastros/curso/<%= c._id %>/excluir" data-confirmar="Excluir este curso permanentemente?"><button class="btn btn-small btn-danger">Excluir</button></form></div></details><% }) %><% if (!cursos.length) { %><div class="empty">Nenhum curso cadastrado.</div><% } %></div>
  </section>
</div></section>

<%- include('../partials/rodape') %>
