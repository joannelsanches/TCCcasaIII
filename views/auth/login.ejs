<%- include('../partials/cabecalho', { titulo: 'Entrar' }) %>

    <section class="login-shell">
        <div class="card login-card">

            <span class="eyebrow">Acesso seguro</span>

            <h1>Entrar no StartIF</h1>

            <% if (erros?.geral) { %><div class="alert erro" role="alert"><%= erros.geral %></div><% } %>

            <form method="post" action="/login" class="stack">

                <div class="field <%= erros?.email ? 'field-invalid' : '' %>">
                    <label for="email">E-mail</label>

                    <input id="email" name="email" type="email" required autocomplete="email" value="<%= valores?.email || '' %>" aria-invalid="<%= erros?.email ? 'true' : 'false' %>" <%= erros?.email ? 'aria-describedby="erro-email"' : '' %>>
                    <% if (erros?.email) { %><small class="field-error" id="erro-email"><%= erros.email %></small><% } %>
                </div>

                <div class="field <%= erros?.senha ? 'field-invalid' : '' %>">
                    <label for="senha">Senha</label>

                    <input id="senha" name="senha" type="password" required autocomplete="current-password" aria-invalid="<%= erros?.senha ? 'true' : 'false' %>" <%= erros?.senha ? 'aria-describedby="erro-senha"' : '' %>>
                    <% if (erros?.senha) { %><small class="field-error" id="erro-senha"><%= erros.senha %></small><% } %>
                </div>

                <button class="btn">
                    Entrar
                </button>

            </form>

            <p class="muted">
                Ainda não tem conta?
                <a href="/cadastro">Cadastre-se</a>.
            </p>

        </div>
    </section>

    <%- include('../partials/rodape') %>
