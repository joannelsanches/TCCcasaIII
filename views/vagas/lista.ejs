<%- include('../partials/cabecalho', { titulo: 'Vagas' }) %>

<section class="section">
  <div class="container container-wide">
    <div class="page-header page-header-left">
      <span class="eyebrow">Oportunidades validadas</span>
      <h1>Vagas abertas</h1>
      <p class="muted">Pesquise por curso, área, cidade ou modalidade.</p>
    </div>

    <form class="card filter-bar" method="get">
      <div class="field"><label for="filtro-q">Palavra-chave ou empresa</label><input id="filtro-q" name="q" value="<%= filtros.q || '' %>" placeholder="Ex.: suporte, programação..."></div>
      <div class="field"><label for="filtro-curso">Curso</label><select id="filtro-curso" name="curso"><option value="">Todos</option><% cursos.forEach(c => { %><option value="<%= c._id %>" <%= String(filtros.curso || '') === String(c._id) ? 'selected' : '' %>><%= c.nome %></option><% }) %></select></div>
      <div class="field"><label for="filtro-campus">Campus</label><select id="filtro-campus" name="campus"><option value="">Todos</option><% campi.forEach(c => { %><option value="<%= c._id %>" <%= String(filtros.campus || '') === String(c._id) ? 'selected' : '' %>><%= c.nome %></option><% }) %></select></div>
      <div class="field"><label for="filtro-area">Área</label><select id="filtro-area" name="area"><option value="">Todas</option><% areas.forEach(a => { %><option value="<%= a._id %>" <%= String(filtros.area || '') === String(a._id) ? 'selected' : '' %>><%= a.nome %></option><% }) %></select></div>
      <div class="field"><label for="filtro-cidade">Cidade</label><input id="filtro-cidade" name="cidade" value="<%= filtros.cidade || '' %>"></div>
      <div class="field"><label for="filtro-bairro">Bairro</label><input id="filtro-bairro" name="bairro" value="<%= filtros.bairro || '' %>"></div>
      <div class="field"><label for="filtro-modalidade">Modalidade</label><select id="filtro-modalidade" name="modalidade"><option value="">Todas</option><% ['PRESENCIAL','HIBRIDO','REMOTO'].forEach(m => { %><option value="<%= m %>" <%= filtros.modalidade === m ? 'selected' : '' %>><%= m %></option><% }) %></select></div>
      <div class="field filter-actions"><button class="btn">Filtrar</button><a href="/vagas">Limpar</a></div>
    </form>

    <div class="section-heading spaced"><h2><%= vagas.length %> oportunidade(s)</h2></div>
    <div class="jobs-grid"><% vagas.forEach(vaga => { %><%- include('../partials/vaga-card', { vaga }) %><% }) %></div>
    <% if (!vagas.length) { %><div class="empty">Nenhuma vaga corresponde aos filtros informados.</div><% } %>
  </div>
</section>

<%- include('../partials/rodape') %>
