<%- include('../partials/cabecalho', { titulo: vaga.titulo }) %>

<section class="section"><div class="container">
  <div class="vacancy-hero card"><% if (vaga.imagem?.caminho) { %><img src="/midia/vagas/<%= vaga._id %>/imagem" alt="Imagem da vaga <%= vaga.titulo %>"><% } else { %><div class="job-image-placeholder"><span>StartIF</span></div><% } %></div>
  <div class="split vacancy-detail">
    <article class="card"><div class="company-line large"><% if (vaga.empresa?.logo?.caminho) { %><img src="/midia/empresas/<%= vaga.empresa._id %>/logo" alt="Logo de <%= formatarNomeProprio(vaga.empresa.nomeFantasia) %>"><% } else { %><span class="mini-initials"><%= iniciais(vaga.empresa?.nomeFantasia) %></span><% } %><strong><%= formatarNomeProprio(vaga.empresa?.nomeFantasia) %></strong></div><span class="badge <%= vaga.status.toLowerCase() %>"><%= vaga.status.replaceAll('_', ' ') %></span><h1><%= vaga.titulo %></h1><p><%= vaga.descricao %></p><h2>Atividades do estágio</h2><p><%= vaga.atividades || 'A confirmar no plano de atividades.' %></p><h2>Requisitos para candidatura</h2><p><%= vaga.requisitos %></p><% if (vaga.requisitosAcademicos) { %><h3>Requisitos acadêmicos</h3><p><%= vaga.requisitosAcademicos %></p><% } %><h3>Cursos aceitos</h3><div class="job-meta"><% vaga.cursosCompativeis.forEach(c => { %><span class="tag"><%= c.nome %></span><% }) %></div><% if (vaga.documentosObrigatorios?.length) { %><h3>Documentos informados pela empresa</h3><ul><% vaga.documentosObrigatorios.forEach(d => { %><li><%= d %></li><% }) %></ul><% } %></article>
    <aside class="card"><h2>Resumo</h2><div class="details-list"><div><strong>Modalidade</strong><%= vaga.modalidade || 'PRESENCIAL' %></div><div><strong>Tipo de estágio</strong><%= (vaga.modalidadeEstagio || 'NAO_OBRIGATORIO').replaceAll('_',' ') %></div><div><strong>Bolsa</strong><%= formatarMoeda(vaga.bolsa) %></div><div><strong>Auxílio-transporte</strong><%= formatarMoeda(vaga.auxilioTransporte) %></div><div><strong>Jornada</strong><%= vaga.cargaHorariaDiaria || '—' %>h/dia · <%= vaga.cargaHorariaSemanal || vaga.cargaHoraria %>h/semana</div><div><strong>Horário</strong><%= vaga.horarioInicio || '—' %> às <%= vaga.horarioFim || '—' %></div><div><strong>Período</strong><%= formatarData(vaga.periodoInicio) %> a <%= formatarData(vaga.periodoFim) %></div><div><strong>Localização</strong><%= vaga.modalidade === 'REMOTO' ? 'Remoto' : formatarEndereco(vaga.localizacao, vaga.localizacaoAntiga) %></div><div><strong>Vagas</strong><%= vaga.quantidadeVagas || 1 %></div><div><strong>Prazo</strong><%= formatarData(vaga.prazo) %></div></div><div class="actions"><% if (usuarioLogado?.tipo === 'ESTUDANTE' && vaga.status === 'ABERTA') { %><form method="post" action="/candidaturas/<%= vaga._id %>" class="full-width"><button class="btn full-width">Candidatar-se</button></form><% } else if (!usuarioLogado) { %><a class="btn full-width" href="/login">Entrar para candidatar-se</a><% } %></div></aside>
  </div>
</div></section>

<%- include('../partials/rodape') %>
